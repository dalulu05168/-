{
  "name": "ellery-westcott-crm",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:demo": "electron . --demo",
    "build:win": "npm run build:vendor && node scripts/build-windows.cjs",
    "build:linux": "electron-builder --linux dir --x64",
    "build:vendor": "node scripts/build-vendor.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/supabase-js": "2.118.0",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.2"
  },
  "description": "Ellery Westcott Capital Markets — connected client management workspace",
  "main": "desktop/main.cjs",
  "author": "Ellery Westcott Capital Markets",
  "build": {
    "appId": "com.ellerywestcott.crm",
    "productName": "Ellery Westcott CRM",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "api/**",
      "assets/**",
      "*.js",
      "*.css",
      "index.html",
      "package.json",
      "!work/**",
      "!demo-client.js",
      "!demo-data.json",
      "!*-setup.sql"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ellery Westcott CRM",
      "artifactName": "Ellery-Westcott-CRM-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/ellery-westcott-transparent.png"
    }
  }
}
