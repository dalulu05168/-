    const pathname = window.location.pathname;
    const locale = pathname.split('/')[1];
    const finalPath = ["de","en","es","es-419","fr","it","pt-br","pt-pt","vi","tr","zh-cn","zh-tw","ja","ko","ar","th","hi"].includes(locale)
      ? pathname.replace('/' + locale, '') || '/' : pathname;
    const supportsDark = finalPath === "/" || ["/screen-live-viewer","/feedback","/report","/onboarding","/onboarding-consumer","/edu/auth","/my-browser","/my-browser-install","/agents/payment-return","/agents/connector-return","/desktop","/team-invitation-migration","/existing-profile-migration",{"mode":"startsWith","path":"/app","exclude":["/appeal-submit"]},{"mode":"startsWith","path":"/login"},{"mode":"startsWith","path":"/login-success"},{"mode":"startsWith","path":"/reset-password"},{"mode":"startsWith","path":"/verify-phone"},{"mode":"startsWith","path":"/verify-email"},{"mode":"startsWith","path":"/auth_landing"},{"mode":"startsWith","path":"/share"},{"mode":"startsWith","path":"/mobile-app"},{"mode":"startsWith","path":"/edu/invitation/"},{"mode":"startsWith","path":"/edu/verify"},{"mode":"startsWith","path":"/app-invite"},{"mode":"startsWith","path":"/add-login-method"},{"mode":"startsWith","path":"/mindpilot"}].some((route) =>
      typeof route === 'object' && route.mode === 'startsWith'
