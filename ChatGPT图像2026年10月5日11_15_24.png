      const key = "manus-theme";
      config = window.desktopLocalStorage?.getItem(key);
      if (!['light', 'dark', 'studio', 'system'].includes(config)) {
        config = localStorage.getItem(key);
      }
    } catch {}
    const dark = supportsDark && (config === 'dark' || config === 'studio' ||
      (config !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches));
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.classList.toggle('light', !dark);
